rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One private workspace per Firebase Auth UID. The pipeline and trial lead
    // list share a document so concurrent edits can check both in a transaction.
    match /sflWorkspaces/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function stageKey(value) {
        return value.matches('^(new|qualified|contacted|responded|won|lost|custom-[0-9a-f-]{36})$');
      }

      function validStage(stage) {
        return stage.keys().hasOnly(['key', 'label', 'color'])
          && stageKey(stage.key)
          && stage.label.matches('(?s)^.{2,40}$')
          && stage.color in ['blue', 'purple', 'cyan', 'amber', 'pink', 'green', 'red', 'slate'];
      }

      function validLeadContact(lead) {
        let rating = lead.get('rating', 0);
        let reviews = lead.get('reviewCount', 0);
        return lead.get('address', '').matches('(?s)^.{0,300}$')
          && lead.get('phone', '').matches('(?s)^.{0,30}$')
          && lead.get('website', '').matches('(?s)^.{0,300}$')
          && lead.get('mapsUrl', '').matches('(?s)^.{0,300}$')
          && lead.get('source', '').matches('(?s)^.{0,60}$')
          && lead.get('websiteChecked', false) is bool
          && rating is number && rating >= 0 && rating <= 5
          && reviews is int && reviews >= 0 && reviews <= 100000000;
      }

      function validLead(lead, basicKeys, keys) {
        let fields = lead.keys();
        return lead.id.matches('(?s)^.{1,350}$')
          && lead.company.matches('(?s)^.{1,160}$')
          && lead.location.matches('(?s)^.{1,100}$')
          && lead.category.matches('(?s)^.{1,100}$')
          && stageKey(lead.stage)
          && lead.get('contacted', false) is bool
          && lead.get('savedAt', '').matches('(?s)^.{0,32}$')
          && (fields.hasOnly(basicKeys) || (fields.hasOnly(keys) && validLeadContact(lead)));
      }

      function validPipeline(stages) {
        let count = stages.size();
        return stages is list && count >= 6 && count <= 15
          && (count <= 0 || validStage(stages[0]))
          && (count <= 1 || validStage(stages[1]))
          && (count <= 2 || validStage(stages[2]))
          && (count <= 3 || validStage(stages[3]))
          && (count <= 4 || validStage(stages[4]))
          && (count <= 5 || validStage(stages[5]))
          && (count <= 6 || validStage(stages[6]))
          && (count <= 7 || validStage(stages[7]))
          && (count <= 8 || validStage(stages[8]))
          && (count <= 9 || validStage(stages[9]))
          && (count <= 10 || validStage(stages[10]))
          && (count <= 11 || validStage(stages[11]))
          && (count <= 12 || validStage(stages[12]))
          && (count <= 13 || validStage(stages[13]))
          && (count <= 14 || validStage(stages[14]));
      }

      function validLeads(leads, previous, count) {
        let basicKeys = ['id', 'company', 'location', 'category', 'stage', 'contacted', 'savedAt'];
        let keys = basicKeys.concat(['address', 'phone', 'website', 'mapsUrl', 'source',
          'websiteChecked', 'rating', 'reviewCount']);
        return (count <= 0 || leads[0] in previous || validLead(leads[0], basicKeys, keys))
          && (count <= 1 || leads[1] in previous || validLead(leads[1], basicKeys, keys))
          && (count <= 2 || leads[2] in previous || validLead(leads[2], basicKeys, keys))
          && (count <= 3 || leads[3] in previous || validLead(leads[3], basicKeys, keys))
          && (count <= 4 || leads[4] in previous || validLead(leads[4], basicKeys, keys))
          && (count <= 5 || leads[5] in previous || validLead(leads[5], basicKeys, keys))
          && (count <= 6 || leads[6] in previous || validLead(leads[6], basicKeys, keys))
          && (count <= 7 || leads[7] in previous || validLead(leads[7], basicKeys, keys))
          && (count <= 8 || leads[8] in previous || validLead(leads[8], basicKeys, keys))
          && (count <= 9 || leads[9] in previous || validLead(leads[9], basicKeys, keys));
      }

      function validWorkspaceKeys(data) {
        return data.keys().hasOnly(['pipeline', 'leads'])
          && data.keys().hasAny(['pipeline', 'leads']);
      }

      function validPipelineField(data) {
        return !('pipeline' in data) || validPipeline(data.pipeline);
      }

      function uniqueLeadIds(leads, count) {
        let ids = [
          count > 0 ? leads[0].id : null,
          count > 1 ? leads[1].id : null,
          count > 2 ? leads[2].id : null,
          count > 3 ? leads[3].id : null,
          count > 4 ? leads[4].id : null,
          count > 5 ? leads[5].id : null,
          count > 6 ? leads[6].id : null,
          count > 7 ? leads[7].id : null,
          count > 8 ? leads[8].id : null,
          count > 9 ? leads[9].id : null
        ];
        // Unused slots are null. Every actual entry must have a valid ID.
        return ids.toSet().size() == (count < 10 ? count + 1 : count);
      }

      function validLeadsField(data, previous) {
        let leads = data.get('leads', []);
        let count = leads.size();
        return leads is list && count <= 10 && uniqueLeadIds(leads, count)
          && validLeads(leads, previous, count);
      }

      // Unchanged fields and identical lead records were validated when written.
      function validWorkspaceUpdate(data, previous) {
        let changed = data.diff(previous).affectedKeys();
        return validWorkspaceKeys(data)
          && (!changed.hasAny(['pipeline']) || validPipelineField(data))
          && (!changed.hasAny(['leads']) || validLeadsField(data, previous.get('leads', [])));
      }

      allow get: if isOwner();
      allow create: if isOwner() && validWorkspaceKeys(request.resource.data)
        && validPipelineField(request.resource.data) && validLeadsField(request.resource.data, []);
      allow update: if isOwner()
        && validWorkspaceUpdate(request.resource.data, resource.data);
    }
  }
}
